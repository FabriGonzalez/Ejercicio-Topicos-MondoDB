# Copiar este archivo como ".env" y completar los valores.
# En Render NO se sube este archivo: se configuran las mismas variables en el panel.

# Puerto donde escucha el servidor (en Render lo inyecta automáticamente)
PORT=4000

#URI de conexión a MongoDB Atlas
#Si la contraseña contiene caracteres especiales (@ : / ? # [ ] %), debe ir en formato URL-encoded.
MONGODB_URI="mongodb+srv://fabrigonzalez171_db_user:TU_CONTRASENA_AQUI@clusterproductos.oym6hbh.mongodb.net/?appName=ClusterProductos"

# Credenciales separadas (opcional). Solo se usan si MONGODB_URI no está definida.
MONGODB_USERNAME="fabrigonzalez171_db_user"
MONGODB_PASSWORD="TU_CONTRASENA_AQUI"
MONGODB_DATABASE="productos"

# Orígenes permitidos para CORS, separados por coma. "true" habilita cualquier origen.
CORS_ORIGIN="*"

# ==========================================================
# Servidor MCP (src/mcp/server.js)
# No necesita MONGODB_URI: consume la API por HTTP.
# ==========================================================

# Endpoint GraphQL que consulta el servidor MCP.
GRAPHQL_URL="https://ejercicio-topicos-mondodb.onrender.com/graphql"

# Timeout de cada llamada a la API, en milisegundos.
# Alto a propósito: Render en plan free hiberna el servicio y el primer request tarda.
GRAPHQL_TIMEOUT_MS="60000"

# ==========================================================
# Agente auditor (src/auditor/index.js, npm run auditor)
# ==========================================================

# Clave de Google AI Studio: https://aistudio.google.com/apikey
# Obligatoria para correr la auditoría.
GOOGLE_GENERATIVE_AI_API_KEY="TU_CLAVE_AQUI"

# Modelo de Gemini a usar (opcional, por defecto gemini-3.5-flash-lite).
# AUDITOR_MODEL="gemini-3.5-flash-lite"
