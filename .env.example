# Copiar este archivo como ".env" y completar los valores.
# En Render NO se sube este archivo: se configuran las mismas variables en el panel.

# Puerto donde escucha el servidor (en Render lo inyecta automáticamente)
PORT=4000

#URI de conexión a MongoDB Atlas
#Si la contraseña contiene caracteres especiales (@ : / ? # [ ] %), debe ir en formato URL-encoded.
MONGODB_URI="mongodb+srv://fabrigonzalez171_db_user:TU_CONTRASENA_AQUI@clusterproductos.oym6hbh.mongodb.net/?appName=ClusterProductos"

# Credenciales separadas (opcional). Solo se usan si MONGODB_URI no está definida.
MONGODB_USERNAME="fabrigonzalez171_db_user"
MONGODB_PASSWORD="TU_CONTRASENA_AQUI"
MONGODB_DATABASE="productos"

# Orígenes permitidos para CORS, separados por coma. "true" habilita cualquier origen.
CORS_ORIGIN="*"
